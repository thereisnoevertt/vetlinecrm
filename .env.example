# ── Скопируйте этот файл в .env и заполните значения ──────────────────────

# Пароль базы данных PostgreSQL
DB_PASSWORD=vetline_secret_change_me

# Telegram Bot Token — получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# Username бота без символа @ (например: VetlineCrmBot)
TELEGRAM_BOT_USERNAME=VetlineCrmBot

# Секретный токен для webhook с сайта (любая случайная строка)
WEBHOOK_SECRET_TOKEN=webhook_secret_change_me

# Публичный URL системы (используется для формирования ссылок)
APP_BASE_URL=http://localhost:8080
